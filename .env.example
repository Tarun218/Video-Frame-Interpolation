# Environment Configuration for Video Frame Interpolation

# Server Configuration
PORT=3000
NODE_ENV=production
HOST=0.0.0.0

# File Upload Configuration (in MB)
MAX_FILE_SIZE=500

# Processing Configuration
PYTHON_PATH=python3
MAX_VIDEO_DURATION=3600
PROCESSING_TIMEOUT=7200000

# Azure Configuration (if using Azure Blob Storage)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=videos

# Logging
LOG_LEVEL=info
